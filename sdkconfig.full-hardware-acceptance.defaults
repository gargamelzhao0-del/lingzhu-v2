# COM5 Miaopan 2.0 full-board acceptance overlay.
# Keep 4G and bottom-UART fixture tests disabled until their external hardware is confirmed.
CONFIG_NUWAX_HW_ACCEPTANCE_MODE=y
# CONFIG_NUWAX_OTA_ENABLE is not set
CONFIG_NUWAX_HW_ACCEPTANCE_SD_ENABLE=y
# CONFIG_NUWAX_HW_ACCEPTANCE_SD_CARD_INSERTED is not set
CONFIG_NUWAX_HW_ACCEPTANCE_LCD_TE_ENABLE=y
# CONFIG_NUWAX_HW_ACCEPTANCE_BASE_UART_LOOPBACK_ENABLE is not set
# CONFIG_NUWAX_HW_ACCEPTANCE_4G_AT_ENABLE is not set
CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE=y
CONFIG_NUWAX_P2_AUDIO_SMOKE_DURATION_MS=5000
CONFIG_NUWAX_P3_HARDREF_AEC_AB_ENABLE=y
# CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE is not set
# CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE is not set
# CONFIG_NUWAX_P3_REF_TDM_REFERENCE_STYLE is not set
# CONFIG_NUWAX_P3_VENDOR_V2_AUDIO_PROFILE is not set
# CONFIG_NUWAX_P3_VENDOR_V2_CLOCK_ALIGNED_TX is not set
# Touch polling is held until P2 diagnostics complete by the dedicated
# post-diagnostic touch/UI path below.
# CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME is not set
CONFIG_NUWAX_P2_POST_DIAG_TOUCH_UI_ENABLE=y
