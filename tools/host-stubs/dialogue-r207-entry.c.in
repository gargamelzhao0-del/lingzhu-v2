@FUNCTION:publish_listening_after_current_asr_failure@
@FUNCTION:resume_prelisten_after_no_speech@
@FUNCTION:is_no_speech_asr_error@
@FUNCTION:note_conversation_cloud_progress@

@ASR_ENTRY@

static void actual_no_speech_entry(void){
    fake_now=1000;owner_polls=activated=0;menu_blocked=false;close_menu_at=0;lifecycle_blocked=false;
    memset(&s_awake_session,0,sizeof(s_awake_session));memset(&s_prelisten,0,sizeof(s_prelisten));
    memset(&s_listen_resume,0,sizeof(s_listen_resume));memset(&s_turn_guard,0,sizeof(s_turn_guard));
    memset(&s_sleep_transaction,0,sizeof(s_sleep_transaction));
    nuwax_awake_session_state_begin(&s_awake_session,60000);
    nuwax_awake_session_state_resume_waiting(&s_awake_session,fake_now);
    set_state(NUWAX_APP_STATE_THINKING);
    nuwax_listen_resume_state_bind_round(&s_listen_resume,s_awake_session.generation,"audio_1");
    nuwax_listen_resume_state_arm_no_speech(&s_listen_resume,"auto_followup",61000);
    assert(nuwax_listen_resume_state_arm_post_end_asr(&s_listen_resume,1,18000));
    fake_now=3000;
    nuwax_session_command_t command={.event=NUWAX_SESSION_EVENT_ASR_RESULT,.ok=false};
    strcpy(command.audio_session_id,"audio_1");strcpy(command.error,"no_speech");
    admitted_asr_event(&command);
    assert(s_prelisten.pending && !s_prelisten.capture_active && !s_awake_session.waiting);
    assert(!nuwax_listen_resume_state_is_waiting_post_end_asr(&s_listen_resume));
    assert(conversation_state_current()==NUWAX_APP_STATE_LISTENING);
}
int main(void){
    (void)prelisten_starts;(void)sync_pending_ui_state;
    actual_no_speech_entry();int ws=1;
    assert(wait_for_mic_start_action(&ws)==ESP_OK && s_prelisten.capture_active);
    puts("control: actual admitted no_speech recovery -> pending -> capture activated");
    actual_no_speech_entry();menu_blocked=true;close_menu_at=5000;
    assert(wait_for_mic_start_action(&ws)==ESP_OK && s_prelisten.capture_active);
    puts("control: menu closes before pending deadline -> capture activated");
    actual_no_speech_entry();s_volume_report.pending=true;s_volume_report.next_attempt_ms=9000;
    session_dispatch_apply_volume_percent(NULL,70,true);
    assert(s_prelisten.pending && mocked_volume==70);
    assert(!s_volume_report.pending&&s_volume_report.next_attempt_ms==0);
    assert(wait_for_mic_start_action(&ws)==ESP_OK && s_prelisten.capture_active);
    puts("control: remote volume callback preserves pending; defect belongs to local shell action route");
    actual_no_speech_entry();nuwax_app_shell_result_t volume={.action=NUWAX_APP_SHELL_ACTION_SET_VOLUME,.index=70};
    nuwax_shell_action_dispatch(&ws,&volume,&action_callbacks);
    assert(s_prelisten.pending && mocked_volume==70);
    assert(wait_for_mic_start_action(&ws)==ESP_OK && s_prelisten.capture_active);
    puts("PASS real no_speech -> local volume -> capture activates without truncation");
    nuwax_shell_action_dispatch(&ws,&volume,&action_callbacks);
    assert(s_prelisten.capture_active);
    puts("PASS volume preserves already active capture");
    unsigned old_reports=volume_report_count;accept_volume_commit=false;volume.index=90;
    nuwax_shell_action_dispatch(&ws,&volume,&action_callbacks);
    assert(mocked_volume==70&&volume_report_count==old_reports&&s_prelisten.capture_active);
    accept_volume_commit=true;
    puts("PASS stale local volume cannot report or interrupt capture; cloud update retires stale report retry");
    actual_no_speech_entry();menu_blocked=true;close_menu_at=62000;
    assert(wait_for_mic_start_action(&ws)==ESP_OK && s_prelisten.capture_active);
    puts("PASS real no_speech -> menu pending expiry -> close -> owner-aware capture recovery");
    return 0;
}
