static bool nuwax_state_bridge_update_owned(nuwax_app_state_t state,uint32_t seq){
    if(inject_sleep && state==NUWAX_APP_STATE_LISTENING){inject_sleep=false;set_state(NUWAX_APP_STATE_SLEEPING);}
    return nuwax_state_bridge_update_owned_real(state,seq);
}
static nuwax_device_state_t state_snapshot(void){return mailbox;}
static bool nuwax_app_shell_publish_app_state_delta_from_bridge(
    nuwax_app_state_t state,const nuwax_device_state_t *patch,
    nuwax_app_shell_state_fields_t fields,uint32_t revision){
    (void)state;
    uint32_t accepted=nuwax_ui_bridge_filter_newer_fields(revision,fields,accepted_revision,32);
    if(accepted & NUWAX_APP_SHELL_STATE_DIALOG) mailbox.dialog=patch->dialog;
    if(accepted & NUWAX_APP_SHELL_STATE_EMOTION) mailbox.emotion=patch->emotion;
    if(accepted & NUWAX_APP_SHELL_STATE_APP_LOW_POWER) mailbox.app_low_power=patch->app_low_power;
    return accepted!=0;
}
