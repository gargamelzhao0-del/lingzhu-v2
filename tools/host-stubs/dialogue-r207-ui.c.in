typedef struct { uint32_t submitted_generation,submitted_connection_epoch; } nuwax_speaker_playback_stats_t;
static bool nuwax_speaker_playback_has_pending(void){return false;}
static void nuwax_speaker_playback_get_stats(nuwax_speaker_playback_stats_t *stats){memset(stats,0,sizeof(*stats));}
static void cancel_pending_semantic_emotion_for_state(nuwax_app_state_t s){(void)s;}
static void set_state(nuwax_app_state_t state);
static bool nuwax_state_bridge_update_owned_real(nuwax_app_state_t state,uint32_t seq);
static bool nuwax_state_bridge_update_owned(nuwax_app_state_t state,uint32_t seq){
    if(inject_sleep && state==NUWAX_APP_STATE_LISTENING){inject_sleep=false;set_state(NUWAX_APP_STATE_SLEEPING);}
    return nuwax_state_bridge_update_owned_real(state,seq);
}


static bool product_music_blocks_audio(void){return false;}
static bool sleep_transaction_blocks_new_audio(void){return false;}
static bool exclusive_audio_mode_blocks_normal_audio(void){return false;}
static bool nuwax_app_shell_blocks_auto_followup(void){return false;}
static bool nuwax_listen_resume_state_holds_idle_expiry_boundary(const void *p){(void)p;return false;}
static uint32_t awake_session_listen_window_ms(uint32_t t){return nuwax_awake_session_state_remaining_ms(&s_awake_session,t);}
static void start_prelisten_window(const char *mode,uint32_t ms,uint32_t delay){(void)mode;(void)ms;(void)delay;++prelisten_starts;}
static void enter_sleeping_conversation_state(const char *reason){(void)reason;++sleep_entries;}
typedef struct {
    uint32_t revision;
    uint32_t published_revision;
    /* Each bridge-owned field has an independent producer watermark. A newer
     * narrow update must not discard unrelated fields from an older delayed
     * transaction. */
    uint32_t bridge_field_revisions[17];
    bool initialized;
    bool app_state_valid;
    nuwax_app_state_t app_state;
    /* The requested expression is retained while a low-battery warning owns
     * the visible face, then restored when the warning clears. */
    nuwax_emotion_t base_emotion;
    nuwax_device_state_t snapshot;
} app_shell_state_mailbox_t;
static app_shell_state_mailbox_t s_state_mailbox;
static int s_ui_mailbox_mux;
static nuwax_device_state_t initial_state;
const nuwax_device_state_t *nuwax_device_state_get(void){return &initial_state;}
static void nuwax_lvgl_port_wake(void){}
static size_t strlcpy(char *dst,const char *src,size_t capacity){
    size_t n=strlen(src);if(capacity){size_t k=n<capacity-1?n:capacity-1;memcpy(dst,src,k);dst[k]=0;}return n;
}

