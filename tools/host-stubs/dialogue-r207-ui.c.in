typedef enum {
    NUWAX_EMOTION_ASSET_DIZZINESS = 1,
    NUWAX_EMOTION_ASSET_HAPPY,
    NUWAX_EMOTION_ASSET_EXCITED,
    NUWAX_EMOTION_ASSET_SLEEPING,
    NUWAX_EMOTION_ASSET_PROVISIONING,
    NUWAX_EMOTION_ASSET_DISCONNECTED,
    NUWAX_EMOTION_ASSET_THINKING,
    NUWAX_EMOTION_ASSET_THOUGHT_COMPLETE,
    NUWAX_EMOTION_ASSET_MEETING,
    NUWAX_EMOTION_ASSET_MONITORING,
    NUWAX_EMOTION_ASSET_TOUCH,
    NUWAX_EMOTION_ASSET_PLAYFUL,
    NUWAX_EMOTION_ASSET_LIKE,
    NUWAX_EMOTION_ASSET_ANGRY,
    NUWAX_EMOTION_ASSET_LISTENING,
    NUWAX_EMOTION_ASSET_QUESTION,
} nuwax_emotion_asset_id_t;
static bool s_provisioning_boot_visual,s_speaking_fallback_active;
static nuwax_emotion_asset_id_t s_speaking_asset;
static bool touch_visual_allowed(const nuwax_device_state_t *s){(void)s;assert(!"unexpected touch branch");return false;}
static nuwax_emotion_asset_id_t semantic_asset(nuwax_emotion_t e){(void)e;assert(!"unexpected semantic branch");return NUWAX_EMOTION_ASSET_HAPPY;}

@FUNCTION:asset_for_state@


static void reset_ui(void){
    memset(&s_conversation_state,0,sizeof(s_conversation_state));
    memset(&s_ui_state_sync,0,sizeof(s_ui_state_sync));
    memset(&s_state_mailbox,0,sizeof(s_state_mailbox));
    memset(&s_emotion_policy,0,sizeof(s_emotion_policy));
    s_emotion_policy_initialized=false;s_current_app_state=s_last_app_state=NUWAX_APP_STATE_BOOTING;s_bridge_revision=0;s_lifecycle_publication_seq=0;
    initial_state=(nuwax_device_state_t){.wifi=NUWAX_WIFI_CONNECTED,.cloud=NUWAX_CLOUD_CONNECTED};
    inject_sleep=inject_after_accept=false;fake_now=100;
}
int main(void){
    (void)prelisten_starts;
    reset_ui();set_state(NUWAX_APP_STATE_LISTENING);set_state(NUWAX_APP_STATE_SLEEPING);
    assert(s_state_mailbox.app_state==NUWAX_APP_STATE_SLEEPING);
    assert(asset_for_state(&s_state_mailbox.snapshot)==NUWAX_EMOTION_ASSET_SLEEPING);
    puts("control: ordered transitions -> real mailbox and face both SLEEPING");
    reset_ui();assert(set_state_logical(NUWAX_APP_STATE_LISTENING,NULL,false));
    inject_sleep=true;sync_pending_ui_state();
    assert(conversation_state_current()==NUWAX_APP_STATE_SLEEPING);
    assert(s_state_mailbox.app_state==NUWAX_APP_STATE_SLEEPING);
    assert(!s_ui_state_sync.pending);
    assert(asset_for_state(&s_state_mailbox.snapshot)==NUWAX_EMOTION_ASSET_SLEEPING);
    fake_now+=10000;nuwax_state_bridge_service(fake_now);sync_pending_ui_state();
    set_state(NUWAX_APP_STATE_SLEEPING);app_shell_post_dialog(NUWAX_DIALOG_LISTENING);
    assert(asset_for_state(&s_state_mailbox.snapshot)==NUWAX_EMOTION_ASSET_SLEEPING);
    puts("PASS stale LISTENING rejected before bridge policy mutation; real mailbox and face remain SLEEPING");
    reset_ui();inject_after_accept=true;set_state(NUWAX_APP_STATE_LISTENING);
    assert(conversation_state_current()==NUWAX_APP_STATE_SLEEPING);
    assert(s_state_mailbox.app_state==NUWAX_APP_STATE_SLEEPING);
    assert(asset_for_state(&s_state_mailbox.snapshot)==NUWAX_EMOTION_ASSET_SLEEPING);
    assert(!s_ui_state_sync.pending);
    puts("PASS field watermark rejects old patch delayed after bridge acceptance");
    return 0;
}
