# Patch a build-local copy; shared ESP-IDF remains unchanged.
if(CONFIG_BT_NIMBLE_ENABLED)
    idf_component_get_property(protocomm_lib protocomm COMPONENT_LIB)
    idf_component_get_property(protocomm_dir protocomm COMPONENT_DIR)
    idf_build_get_property(protocomm_python PYTHON)
    set(protocomm_original "${protocomm_dir}/src/transports/protocomm_nimble.c")
    set(protocomm_script "${CMAKE_CURRENT_LIST_DIR}/../patch-protocomm-lifecycle.py")
    set(protocomm_patched "${CMAKE_BINARY_DIR}/nuwax_patches/protocomm_nimble.c")
    execute_process(COMMAND "${protocomm_python}" "${protocomm_script}"
        --input "${protocomm_original}" --output "${protocomm_patched}"
        RESULT_VARIABLE protocomm_patch_result)
    if(NOT protocomm_patch_result EQUAL 0)
        message(FATAL_ERROR "Unreviewed NimBLE transport: lifecycle patch failed")
    endif()
    get_target_property(protocomm_sources ${protocomm_lib} SOURCES)
    set(protocomm_replaced 0)
    set(protocomm_new_sources "")
    foreach(source IN LISTS protocomm_sources)
        if(source MATCHES "(^|/)protocomm_nimble\\.c$")
            list(APPEND protocomm_new_sources "${protocomm_patched}")
            math(EXPR protocomm_replaced "${protocomm_replaced}+1")
        else()
            list(APPEND protocomm_new_sources "${source}")
        endif()
    endforeach()
    if(NOT protocomm_replaced EQUAL 1)
        message(FATAL_ERROR "Expected exactly one NimBLE transport source")
    endif()
    set_property(TARGET ${protocomm_lib} PROPERTY SOURCES "${protocomm_new_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${protocomm_script}" "${protocomm_original}")
endif()
