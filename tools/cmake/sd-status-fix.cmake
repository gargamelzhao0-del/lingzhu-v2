# SDK source is pinned and generated into this build; installed SDK untouched.
idf_component_get_property(sd_status_lib sdmmc COMPONENT_LIB)
idf_component_get_property(sd_status_root sdmmc COMPONENT_DIR)
idf_build_get_property(sd_status_python PYTHON)
set(sd_status_script "${CMAKE_CURRENT_LIST_DIR}/../prepare-sd-status-fix.py")
set(sd_status_output "${CMAKE_BINARY_DIR}/sd-status-fix/sdmmc_cmd.c")
execute_process(COMMAND "${sd_status_python}" "${sd_status_script}"
    --input "${sd_status_root}/sdmmc_cmd.c" --output "${sd_status_output}"
    RESULT_VARIABLE sd_status_result)
if(NOT sd_status_result EQUAL 0)
    message(FATAL_ERROR "SDMMC status fix rejected unreviewed SDK source")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${sd_status_script}" "${sd_status_root}/sdmmc_cmd.c")
get_target_property(sd_status_sources ${sd_status_lib} SOURCES)
set(sd_status_replaced 0)
set(sd_status_updated)
foreach(sd_source IN LISTS sd_status_sources)
    get_filename_component(sd_absolute "${sd_source}" ABSOLUTE BASE_DIR "${sd_status_root}")
    if(sd_absolute STREQUAL "${sd_status_root}/sdmmc_cmd.c")
        list(APPEND sd_status_updated "${sd_status_output}")
        math(EXPR sd_status_replaced "${sd_status_replaced}+1")
    else()
        list(APPEND sd_status_updated "${sd_source}")
    endif()
endforeach()
if(NOT sd_status_replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one SDMMC command source substitution")
endif()
set_property(TARGET ${sd_status_lib} PROPERTY SOURCES "${sd_status_updated}")
target_include_directories(${sd_status_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../main/board")
