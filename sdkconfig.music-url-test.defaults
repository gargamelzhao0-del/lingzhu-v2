# Development-only one-shot URL playback overlay. Keep sdkconfig.defaults and
# product OTA configurations disabled; opt in with SDKCONFIG_DEFAULTS.
CONFIG_NUWAX_MUSIC_URL_TEST_ENABLE=y
CONFIG_NUWAX_MUSIC_URL_TEST_URL="http://192.168.31.180:8798/music.pcm"
CONFIG_NUWAX_MUSIC_URL_TEST_STABLE_DELAY_MS=10000
CONFIG_NUWAX_MUSIC_URL_TEST_HTTP_TIMEOUT_MS=10000
CONFIG_NUWAX_MUSIC_URL_TEST_MAX_BYTES=19200000
