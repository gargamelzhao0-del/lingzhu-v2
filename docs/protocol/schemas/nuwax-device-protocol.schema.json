      "required": ["command", "wake_word"],
      "properties": {
        "command": { "const": "set_wake_word" },
        "wake_word": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9 \\t\\r\\n]+$"
          }
        },
        "persist": { "type": "boolean" }
