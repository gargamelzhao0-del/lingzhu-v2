    "setWakeWordCommand": {
      "allOf": [
        { "$ref": "#/$defs/deviceCommandBase" },
        {
          "type": "object",
          "oneOf": [
            { "required": ["wake_word"] },
            { "required": ["wakeWord"] }
          ],
          "properties": {
            "command": { "const": "set_wake_word" },
            "wake_word": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9 \\t\\r\\n]+$"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9 \\t\\r\\n]+$"
                  }
                }
              ]
            },
            "wakeWord": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9 \\t\\r\\n]+$"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 63,
                    "pattern": "^[A-Za-z0-9 \\t\\r\\n]+$"
                  }
                }
              ]
            },
            "persist": { "type": "boolean" },
            "wake_word_persist": { "type": "boolean" },
            "wakeWordPersist": { "type": "boolean" }
          }
        }
      ]
    },
