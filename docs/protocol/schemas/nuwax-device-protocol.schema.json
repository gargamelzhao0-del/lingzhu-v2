          "properties": {
            "command": { "const": "set_emotion" },
            "emotion": { "$ref": "#/$defs/emotion" },
            "assistant_emotion": { "$ref": "#/$defs/emotion" },
            "assistantEmotion": { "$ref": "#/$defs/emotion" }
          }
        }
      ]
    },
    "setVolumeCommand": {
      "allOf": [
        { "$ref": "#/$defs/deviceCommandBase" },
        {
          "type": "object",
