{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuwax.local/schemas/nuwax-device-protocol.schema.json",
  "title": "Nuwax AI Partner Device WebSocket Protocol",
  "description": "Machine-readable JSON contract for Nuwax device/server WebSocket text messages. Unknown extension fields are allowed; known fields are constrained to the current device buffer and protocol limits.",
  "oneOf": [
    { "$ref": "#/$defs/deviceToServerMessage" },
    { "$ref": "#/$defs/serverToDeviceMessage" }
  ],
  "$defs": {
    "commandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 31,
      "x-maxUtf8Bytes": 31,
      "pattern": "^[a-z0-9_]+$"
    },
    "mode": {
      "type": "string",
      "maxLength": 23,
      "x-maxUtf8Bytes": 23
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "x-maxUtf8Bytes": 39,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "x-maxUtf8Bytes": 39,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "audioSessionId": {
      "type": "string",
      "maxLength": 47,
      "x-maxUtf8Bytes": 47
    },
    "turnId": {
      "type": "string",
      "maxLength": 47,
      "x-maxUtf8Bytes": 47
    },
    "playbackId": {
      "type": "string",
      "maxLength": 47,
      "x-maxUtf8Bytes": 47
    },
    "notifyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 47,
      "x-maxUtf8Bytes": 47,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider": {
      "type": "string",
      "maxLength": 23,
      "x-maxUtf8Bytes": 23
    },
    "reason": {
      "type": "string",
      "maxLength": 23,
      "x-maxUtf8Bytes": 23
    },
    "title": {
      "type": "string",
      "maxLength": 39,
      "x-maxUtf8Bytes": 39
    },
    "line": {
      "type": "string",
      "maxLength": 47,
      "x-maxUtf8Bytes": 47
    },
    "assistantText": {
      "type": "string",
      "maxLength": 511,
      "x-maxUtf8Bytes": 511
    },
    "userText": {
      "type": "string",
      "maxLength": 255,
      "x-maxUtf8Bytes": 255
    },
    "errorText": {
      "type": "string",
      "maxLength": 127,
      "x-maxUtf8Bytes": 127
    },
    "ssid": {
      "type": "string",
      "maxLength": 32,
      "x-maxUtf8Bytes": 32
    },
    "password": {
      "type": "string",
      "maxLength": 64,
      "x-maxUtf8Bytes": 64
    },
    "emotion": {
      "type": "string",
      "maxLength": 23,
      "enum": [
        "neutral",
        "normal",
        "idle",
        "happy",
        "smile",
        "surprised",
        "wink",
        "tongue",
        "thinking",
        "think",
        "focused",
        "pensive",
        "analyzing",
        "analysis",
        "processing",
        "received",
        "what",
        "confused",
        "understood",
        "ok",
        "awesome",
        "great",
        "like",
        "sad",
        "sorry",
        "error",
        "lost",
        "angry",
        "shy",
        "tired",
        "dizziness",
        "dizzy",
        "excited",
        "thought_complete",
        "thinking_complete",
        "sleeping",
        "sleep",
        "provisioning",
        "pairing",
        "disconnected",
        "offline",
        "meeting",
        "monitoring",
        "monitor",
        "touch",
        "touched",
        "playful",
        "question"
      ]
    },
    "deviceState": {
      "type": "string",
      "maxLength": 23,
      "enum": [
        "sleeping",
        "wake_only"
      ]
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 48000
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "frameDurationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "otaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "x-maxUtf8Bytes": 63,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]{0,62}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "firmwareIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firmware_type", "version", "image_sha256"],
      "properties": {
        "firmware_type": { "const": "NuwaxAIPartner_V2" },
        "version": { "type": "string", "minLength": 1, "maxLength": 31 },
        "image_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "audioParams": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "input_format",
        "codec",
        "opus",
        "output_format",
        "sample_rate",
        "output_sample_rate",
        "channels",
        "frame_duration_ms"
      ],
      "properties": {
        "input_format": { "type": "string", "enum": ["pcm16", "opus"] },
        "codec": { "type": "string", "enum": ["pcm16", "opus"] },
        "opus": { "type": "boolean" },
        "output_format": { "type": "string", "enum": ["pcm16"] },
        "sample_rate": { "$ref": "#/$defs/sampleRate" },
        "output_sample_rate": { "$ref": "#/$defs/sampleRate" },
        "channels": { "$ref": "#/$defs/channels" },
        "mic_channels": { "type": "integer", "minimum": 1, "maximum": 8 },
        "frame_duration_ms": { "$ref": "#/$defs/frameDurationMs" },
        "speaker": { "type": "boolean" },
        "wake_word": { "type": "boolean" },
        "vad": { "type": "boolean" },
        "full_duplex": { "type": "boolean" },
        "shared_i2s": { "type": "boolean" },
        "hardware_profile": { "type": "string", "maxLength": 63 },
        "aec": { "type": "boolean" },
        "aec_reference": {
          "type": "string",
          "enum": [
            "none",
            "es7210_slot2",
            "software",
            "es7210_slot2_software_fallback"
          ]
        },
        "has_ref": { "type": "boolean" },
        "ref_slot": { "type": "integer", "minimum": 0, "maximum": 7 },
        "afe_input_format": { "type": "string", "enum": ["MM", "MR", "MMR"] }
      }
    },
    "deviceToServerMessage": {
      "oneOf": [
        { "$ref": "#/$defs/hello" },
        { "$ref": "#/$defs/firmwareReport" },
        { "$ref": "#/$defs/otaAck" },
        { "$ref": "#/$defs/otaResult" },
        { "$ref": "#/$defs/devicePing" },
        { "$ref": "#/$defs/listen" },
        { "$ref": "#/$defs/offlineAudioBegin" },
        { "$ref": "#/$defs/offlineAudioCommit" },
        { "$ref": "#/$defs/monitoringCaptureControl" },
        { "$ref": "#/$defs/textRequest" },
        { "$ref": "#/$defs/cancelTurn" },
        { "$ref": "#/$defs/inputEvent" },
        { "$ref": "#/$defs/wifiScanResult" },
        { "$ref": "#/$defs/wifiStatus" },
        { "$ref": "#/$defs/volumeChanged" },
        { "$ref": "#/$defs/deviceErrorReport" },
        { "$ref": "#/$defs/deviceCommandAck" },
        { "$ref": "#/$defs/musicPlaybackStatus" },
         { "$ref": "#/$defs/legacySetWakeWordAck" },
        { "$ref": "#/$defs/notifyPlaybackAck" },
        { "$ref": "#/$defs/notifyPlaybackCancelled" },
        { "$ref": "#/$defs/pcStatusRequest" },
        { "$ref": "#/$defs/statusAppRequest" }
      ]
    },
    "serverToDeviceMessage": {
      "oneOf": [
        { "$ref": "#/$defs/pong" },
        { "$ref": "#/$defs/firmwareReportAck" },
        { "$ref": "#/$defs/otaResultAck" },
        { "$ref": "#/$defs/offlineAudioBeginAck" },
        { "$ref": "#/$defs/offlineAudioChunkAck" },
        { "$ref": "#/$defs/offlineAudioCommitAck" },
        { "$ref": "#/$defs/monitoringCaptureControlAck" },
        { "$ref": "#/$defs/deviceCommand" },
        { "$ref": "#/$defs/legacySetWakeWordCommand" },
        { "$ref": "#/$defs/asrPartial" },
        { "$ref": "#/$defs/asrFinal" },
        { "$ref": "#/$defs/asrResult" },
        { "$ref": "#/$defs/audioSession" },
        { "$ref": "#/$defs/textResponse" },
        { "$ref": "#/$defs/playbackBegin" },
        { "$ref": "#/$defs/playbackEnd" },
        { "$ref": "#/$defs/notifyPlaybackBegin" },
        { "$ref": "#/$defs/notifyPlaybackEnd" },
        { "$ref": "#/$defs/deviceErrorReportAck" },
        { "$ref": "#/$defs/ttsResult" },
        { "$ref": "#/$defs/ttsSkip" },
        { "$ref": "#/$defs/mcp" },
        { "$ref": "#/$defs/inputEventAck" },
        { "$ref": "#/$defs/cancelTurnAck" }
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "version", "device_id", "device_secret", "transport", "features", "audio_params"],
      "properties": {
        "type": { "const": "hello" },
        "version": { "type": "integer", "minimum": 1 },
        "device_id": { "type": "string", "maxLength": 63 },
        "device_secret": { "type": "string", "minLength": 1, "maxLength": 95 },
        "transport": { "const": "websocket" },
        "has_sd_card": { "type": "boolean", "description": "Latest completed SD detection result. Current firmware always sends this field; omitted by older firmware means unknown. Does not imply writable space or a successful mode start." },
        "features": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "audio_upload": { "type": "boolean" },
            "audio_playback": { "type": "boolean" },
            "music_playback_mp3": { "type": "boolean" },
            "mcp": { "type": "boolean" },
            "meeting_mode_v1": { "type": "boolean" },
            "monitoring_mode_v1": { "type": "boolean" },
            "monitoring_pause_resume_v1": { "type": "boolean" },
            "remote_ble_reprovision": { "type": "boolean" },
            "volume_changed_v1": { "type": "boolean" }
          }
        },
        "audio_params": { "$ref": "#/$defs/audioParams" }
      }
    },
    "firmwareReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "report_id", "device_id", "device_secret", "reset_reason", "firmware"],
      "properties": {
        "type": { "const": "firmware_report" },
        "report_id": { "$ref": "#/$defs/otaId" },
        "device_id": { "type": "string", "minLength": 1, "maxLength": 63 },
        "device_secret": { "type": "string", "minLength": 1, "maxLength": 95 },
        "reset_reason": { "type": "string", "enum": ["power_on", "external", "software", "panic", "interrupt_watchdog", "task_watchdog", "watchdog", "deep_sleep", "brownout", "sdio", "unknown"] },
        "firmware": { "$ref": "#/$defs/firmwareIdentity" }
      }
    },
    "firmwareReportAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "report_id", "persisted"],
      "properties": {
        "type": { "const": "firmware_report_ack" },
        "report_id": { "$ref": "#/$defs/otaId" },
        "persisted": { "type": "boolean" }
      }
    },
    "otaAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "update_id", "accepted"],
      "properties": {
        "type": { "const": "ota_ack" },
        "update_id": { "$ref": "#/$defs/otaId" },
        "accepted": { "type": "boolean" }
      }
    },
    "otaResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "update_id", "ok", "message"],
      "properties": {
        "type": { "const": "ota_result" },
        "update_id": { "$ref": "#/$defs/otaId" },
        "ok": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 127 }
      }
    },
    "otaResultAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "update_id", "ok"],
      "properties": {
        "type": { "const": "ota_result_ack" },
        "update_id": { "$ref": "#/$defs/otaId" },
        "ok": { "type": "boolean" }
      }
    },
    "devicePing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "now_ms"],
      "properties": {
        "type": { "const": "ping" },
        "now_ms": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "now_ms"],
      "properties": {
        "type": { "const": "pong" },
        "now_ms": { "$ref": "#/$defs/nonNegativeInt" },
        "server_ms": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "listen": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "state", "mode"],
      "properties": {
        "type": { "const": "listen" },
        "state": { "type": "string", "enum": ["start", "stop"] },
        "mode": { "$ref": "#/$defs/mode" },
        "audio_session_id": { "$ref": "#/$defs/audioSessionId" },
        "audioSessionId": { "$ref": "#/$defs/audioSessionId" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "offlineSegmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 47,
      "x-maxUtf8Bytes": 47,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "offlineAudioBegin": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "segment_id", "total_bytes", "crc32"],
      "properties": {
        "type": { "const": "offline_audio_begin" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "segment_id": { "$ref": "#/$defs/offlineSegmentId" },
        "total_bytes": { "$ref": "#/$defs/nonNegativeInt" },
        "crc32": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "offlineAudioCommit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "segment_id", "total_bytes", "crc32"],
      "properties": {
        "type": { "const": "offline_audio_commit" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "segment_id": { "$ref": "#/$defs/offlineSegmentId" },
        "total_bytes": { "$ref": "#/$defs/nonNegativeInt" },
        "crc32": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "offlineAudioBeginAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "ok"],
      "properties": {
        "type": { "const": "offline_audio_begin_ack" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "next_offset": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "offlineAudioChunkAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "ok", "next_offset"],
      "properties": {
        "type": { "const": "offline_audio_chunk_ack" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "next_offset": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "offlineAudioCommitAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "ok"],
      "properties": {
        "type": { "const": "offline_audio_commit_ack" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" }
      }
    },
    "monitoringCaptureControl": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "mode", "state", "audio_session_id", "reason"],
      "properties": {
        "type": { "const": "monitoring_capture_control" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "mode": { "const": "monitoring" },
        "state": { "type": "string", "enum": ["pause", "resume"] },
        "audio_session_id": { "$ref": "#/$defs/audioSessionId" },
        "reason": { "type": "string", "enum": ["no_speech", "speech_detected"] },
        "silence_ms": { "$ref": "#/$defs/nonNegativeInt" }
      }
    },
    "monitoringCaptureControlAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "mode", "state", "audio_session_id", "ok", "reason"],
      "properties": {
        "type": { "const": "monitoring_capture_control_ack" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "mode": { "const": "monitoring" },
        "state": { "type": "string", "enum": ["pause", "resume"] },
        "audio_session_id": { "$ref": "#/$defs/audioSessionId" },
        "ok": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/errorText" },
        "duplicate": { "type": "boolean" }
      }
    },
    "textRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "text"],
      "properties": {
        "type": { "const": "text_request" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "text": { "$ref": "#/$defs/assistantText" }
      }
    },
    "cancelTurn": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "turn_id", "reason"],
      "properties": {
        "type": { "const": "cancel_turn" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "turn_id": { "$ref": "#/$defs/turnId" },
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "inputEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "source", "action"],
      "properties": {
        "type": { "const": "input_event" },
        "source": { "type": "string", "maxLength": 23 },
        "action": { "type": "string", "maxLength": 23 },
        "touch": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x": { "$ref": "#/$defs/nonNegativeInt" },
            "y": { "$ref": "#/$defs/nonNegativeInt" },
            "gesture": { "$ref": "#/$defs/nonNegativeInt" },
            "points": { "$ref": "#/$defs/nonNegativeInt" },
            "event": { "$ref": "#/$defs/nonNegativeInt" }
          }
        }
      }
    },
    "wifiScanResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "ok", "count", "networks"],
      "properties": {
        "type": { "const": "wifi_scan_result" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "message": { "$ref": "#/$defs/errorText" },
        "count": { "$ref": "#/$defs/nonNegativeInt" },
        "networks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["ssid", "rssi", "authmode", "secure"],
            "properties": {
              "ssid": { "$ref": "#/$defs/ssid" },
              "rssi": { "type": "integer", "minimum": -127, "maximum": 20 },
              "authmode": { "$ref": "#/$defs/nonNegativeInt" },
              "secure": { "type": "boolean" }
            }
          }
        }
      }
    },
    "wifiStatus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "phase", "ok"],
      "properties": {
        "type": { "const": "wifi_status" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "phase": { "type": "string", "enum": ["connecting", "connected", "failed", "disconnected", "recovery_pending"] },
        "ssid": { "$ref": "#/$defs/ssid" },
        "ip": { "type": "string", "maxLength": 45 },
        "ok": { "type": "boolean" },
        "message": { "$ref": "#/$defs/errorText" }
      }
    },
    "volumeChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "volume_percent", "source"],
      "properties": {
        "type": { "const": "volume_changed" },
        "event_id": { "$ref": "#/$defs/eventId" },
        "volume_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "source": { "type": "string", "enum": ["device_ui", "device_sync"] }
      }
    },
    "deviceErrorReport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "event_id", "severity", "component", "code"],
      "properties": {
        "type": { "const": "device_error_report" },
        "event_id": { "$ref": "#/$defs/eventId" },
        "severity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 11,
          "x-maxUtf8Bytes": 11
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 23,
          "x-maxUtf8Bytes": 23
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 47,
          "x-maxUtf8Bytes": 47
        },
        "result": {
          "type": "string",
          "maxLength": 159,
          "x-maxUtf8Bytes": 159
        },
        "uptime_ms": { "$ref": "#/$defs/nonNegativeInt" },
        "state": {
          "type": "string",
          "maxLength": 23,
          "x-maxUtf8Bytes": 23
        },
        "generation": { "$ref": "#/$defs/nonNegativeInt" },
        "turn_id": { "$ref": "#/$defs/turnId" }
      }
    },
    "deviceErrorReportAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "event_id", "accepted"],
      "properties": {
        "type": { "const": "device_error_report_ack" },
        "event_id": { "$ref": "#/$defs/eventId" },
        "accepted": { "type": "boolean" }
      }
    },
    "deviceCommandAck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "command", "ok"],
      "properties": {
        "type": { "const": "device_command_ack" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "command": { "$ref": "#/$defs/commandName" },
        "ok": { "type": "boolean" },
        "message": { "$ref": "#/$defs/errorText" }
      }
    },
    "musicPlaybackStatus": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "state"],
      "properties": {
        "type": { "const": "music_playback_status" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "state": { "type": "string", "enum": ["playing", "completed", "failed", "cancelled"] },
