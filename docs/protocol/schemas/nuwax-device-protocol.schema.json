    "otaUpdateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "update_id", "url", "version", "size_bytes", "image_sha256"],
      "properties": {
        "type": { "const": "device_command" },
        "command": { "const": "ota_update" },
        "update_id": { "$ref": "#/$defs/otaId" },
        "url": { "type": "string", "minLength": 9, "maxLength": 255, "pattern": "^https://" },
        "version": { "type": "string", "minLength": 1, "maxLength": 31, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "image_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deviceCommandBase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "request_id", "command"],
      "properties": {
        "type": { "const": "device_command" },
        "request_id": { "$ref": "#/$defs/requestId" },
