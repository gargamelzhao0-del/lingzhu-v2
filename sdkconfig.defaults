CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y

# UI render performance baseline.
# LVGL software rendering (pixel blend + anti-aliased lines/arcs) is a CPU-bound
# hot loop. On-device measurement showed render throughput stuck at ~20-60万
# px/s regardless of buffer location, dirty area, or redraw frequency -- the
# tell-tale of debug-grade codegen plus a sub-max clock, not a UI-code problem.
#   -Og (DEBUG) -> -O2 (PERF): ~3-10x faster on the pixel loops.
#   160MHz -> 240MHz: +50% CPU headroom for rendering.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# ESP32-S3 module baseline
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.customwake.csv"
CONFIG_NUWAX_VOCAT_AUDIO_DMA_DESC_NUM=8
CONFIG_NUWAX_WAKE_WORD_ENABLE=y
# CONFIG_NUWAX_WAKE_WORD_BACKEND_WAKENET is not set
CONFIG_NUWAX_WAKE_WORD_BACKEND_MULTINET=y
CONFIG_NUWAX_CUSTOM_WAKE_WORD_COMMAND="xiao zhu xiao zhu"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_DISPLAY="小珠小珠"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_LANGUAGE="cn"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_DURATION_MS=3000
CONFIG_NUWAX_CUSTOM_WAKE_WORD_THRESHOLD_PERCENT=9
CONFIG_NUWAX_WAKE_WORD_TASK_PRIORITY=10
CONFIG_NUWAX_WAKE_CAPTURE_TASK_STACK_BYTES=6144
CONFIG_NUWAX_WAKE_CAPTURE_TASK_PRIORITY=11
CONFIG_NUWAX_WAKE_CAPTURE_QUEUE_DEPTH=12
CONFIG_NUWAX_P3_SOFTWARE_REF_ENABLE=y
# CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE is not set
# CONFIG_NUWAX_WAKE_WORD_INTERRUPT_SHADOW_ONLY is not set
CONFIG_NUWAX_WAKE_WORD_INTERRUPT_THRESHOLD_PERCENT=10
CONFIG_NUWAX_WAKE_WORD_INTERRUPT_FADE_MS=15
CONFIG_NUWAX_WAKE_WORD_INTERRUPT_POST_STOP_GUARD_MS=120
CONFIG_NUWAX_WAKE_WORD_INTERRUPT_EVENT_MAX_AGE_MS=250
CONFIG_NUWAX_TOUCH_WAKE_ACTION_ENABLE=n
CONFIG_NUWAX_TOUCH_INTERRUPT_ACTION_ENABLE=y
CONFIG_NUWAX_CONVERSATION_AWAKE_IDLE_TIMEOUT_MS=60000
CONFIG_NUWAX_CONVERSATION_IDLE_SLEEP_MS=0
CONFIG_NUWAX_VOICE_FRAME_DURATION_MS=20
CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_AVG_ABS=281
CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_PEAK=1105
CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_AVG_ABS=130
CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_PEAK=520
CONFIG_NUWAX_VOICE_LOCAL_VAD_MIN_SPEECH_MS=300
CONFIG_NUWAX_SPEECH_CONFIRMATION_MODE_LEGACY=y
CONFIG_NUWAX_SHORT_SPEECH_POLICY_MODE_ACTIVE=y
CONFIG_NUWAX_VOICE_LOCAL_VAD_MIN_CAPTURE_MS=700
CONFIG_NUWAX_VOICE_LOCAL_VAD_TRAILING_SILENCE_MS=1200
CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE=y
CONFIG_NUWAX_MIC_LEVEL_LOG_INTERVAL_FRAMES=0
# CONFIG_NUWAX_REALTIME_AUDIO_DIAGNOSTIC_LOG_ENABLE is not set
CONFIG_NUWAX_MONITORING_SILENCE_STOP_MS=120000
CONFIG_NUWAX_MONITORING_CAPTURE_ACK_TIMEOUT_MS=1500
CONFIG_NUWAX_MONITORING_CAPTURE_ACK_MAX_RETRIES=3
CONFIG_NUWAX_MONITORING_ESP_VAD_ENABLE=y
CONFIG_NUWAX_MONITORING_PREROLL_MS=500
CONFIG_NUWAX_MONITORING_SPEECH_CONFIRM_FRAMES=3
CONFIG_NUWAX_MONITORING_RESUME_CONFIRM_FRAMES=10
CONFIG_NUWAX_MONITORING_RESUME_GUARD_MS=300
CONFIG_NUWAX_MONITORING_RESUME_QUIET_FRAMES=10
CONFIG_NUWAX_MONITORING_SPEECH_REFRESH_FRAMES=10
CONFIG_NUWAX_MONITORING_SPEECH_MIN_AVG_ABS=208
CONFIG_NUWAX_MONITORING_SPEECH_MIN_PEAK=780
CONFIG_NUWAX_MONITORING_SPEECH_NOISE_MARGIN_ABS=104
# CONFIG_SR_MN_CN_NONE is not set
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
# CONFIG_NUWAX_LIVE_AEC_MODE_HIGH_PERF is not set
CONFIG_NUWAX_LIVE_AEC_ENABLE=n
# Live AEC is intentionally disabled for the stable long-TTS product profile.
# Raw microphone uplink and VAD remain enabled; barge-in/AEC will be re-enabled
# only after the internal contiguous-memory profile is validated separately.
CONFIG_NUWAX_LIVE_AEC_MODE_LOW_COST=y
CONFIG_NUWAX_LIVE_AEC_DUAL_RESTORE_ENABLE=y
CONFIG_NUWAX_LIVE_AEC_DUAL_RESTORE_HINT_GAIN_Q15=8192
# CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE is not set
# CONFIG_NUWAX_LIVE_AEC_ADAPTIVE_REF_ENABLE is not set
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_ENABLE=y
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_PROVISIONAL_MIX_Q15=24576
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15=24576
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_FAST_MIX_Q15=24576
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_MAX_REF_GAIN_Q15=65536
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_MIN_REF_CORR_Q15=8192
# CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_FIR_ENABLE is not set
CONFIG_NUWAX_LIVE_AEC_POST_BLEND_RESIDUAL_ENABLE=y
CONFIG_NUWAX_LIVE_AEC_POST_BLEND_RESIDUAL_MIN_CORR_Q15=12000
CONFIG_NUWAX_LIVE_AEC_POST_BLEND_RESIDUAL_MAX_GAIN_Q15=65536
CONFIG_NUWAX_LIVE_AEC_NEAREND_RAW_MIX_Q15=0
CONFIG_NUWAX_LIVE_AEC_STRONG_NEAREND_RAW_MIX_Q15=0
CONFIG_NUWAX_AUDIO_CLEANER_PLAYBACK_UNPROTECTED_ATTENUATE_Q15=32768
CONFIG_NUWAX_BARGE_IN_ENABLE=n
CONFIG_NUWAX_VOICE_UPLINK_QUEUE_DEPTH=64
CONFIG_NUWAX_VOICE_UPLINK_REALTIME_MAX_AGE_MS=1000
CONFIG_NUWAX_SPEAKER_BUFFER_BYTES=393216
CONFIG_NUWAX_SPEAKER_BACKPRESSURE_POLL_MS=20
CONFIG_NUWAX_SPEAKER_STREAM_STALL_WARN_MS=12000
CONFIG_NUWAX_SPEAKER_STREAM_STALL_TIMEOUT_MS=60000
CONFIG_NUWAX_SPEAKER_REBUFFER_STALL_TIMEOUT_MS=15000
CONFIG_NUWAX_RT_CAPTURE_QUEUE_DEPTH=12
CONFIG_NUWAX_RT_CAPTURE_MAX_DECISION_AGE_MS=60
CONFIG_NUWAX_WIFI_REALTIME_DISABLE_POWER_SAVE=y
CONFIG_NUWAX_BARGE_END_TO_END_MAX_FRAME_AGE_MS=100

# External PSRAM is required by the LVGL V28 UI and audio/display coexistence path.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Keep enough internal RAM for Wi-Fi management frames while PSRAM carries the
# bulk buffers. The configured BA window is 6, so six static RX/TX buffers
# retain that window without reserving about 32 KB for ten of each.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Security 2 SRP6a needs substantially more temporary crypto heap than remains
# in internal DRAM after the UI, Wi-Fi and audio stacks are initialized.
# Keep mbedTLS/PSA dynamic allocations in the module's 8 MB PSRAM.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# The IDF 6.0 PSA hardware SHA/AES drivers require internal DMA contexts.
# Security 2 can exhaust that heap during SRP6a-3072, while the software paths
# operate from normal/PSRAM-backed memory without weakening the algorithms.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set

CONFIG_NUWAX_TLS_TRYCLOUDFLARE_CA_ENABLE=y
CONFIG_NUWAX_TIME_SYNC_SERVER="ntp.aliyun.com"
CONFIG_NUWAX_TIME_SYNC_TIMEOUT_MS=12000
CONFIG_NUWAX_PROTOCOL_LISTEN_STOP_ENABLE=y

# Round display and touch baseline.
CONFIG_NUWAX_DISPLAY_ENABLE=y
CONFIG_NUWAX_DISPLAY_QSPI_ENABLE=y
CONFIG_NUWAX_DISPLAY_SPI_HZ=40000000
CONFIG_NUWAX_TOUCH_POLL_INTERVAL_MS=10
CONFIG_NUWAX_HEAD_TOUCH_ENABLE=y
CONFIG_NUWAX_HEAD_TOUCH_LONG_PRESS_MS=650
CONFIG_NUWAX_HEAD_TOUCH_GAP_TOLERANCE_MS=750
CONFIG_NUWAX_HEAD_TOUCH_MAX_VALID_DURATION_MS=5000

# The RX task lives in PSRAM. Reserve enough stack for JSON dispatch and a
# synchronous TLS protocol reply without consuming scarce internal RAM.
CONFIG_NUWAX_WS_RX_TASK_STACK_BYTES=16384

# I2C transactions use application buffers and task stacks that may otherwise
# be external-memory backed. Do not run the master ISR during flash/cache-off
# windows; this prevents an ISR from writing to an inaccessible PSRAM/flash
# address while OTA/NVS operations temporarily suspend the cache.
# CONFIG_I2C_ISR_IRAM_SAFE is not set
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=y

CONFIG_NUWAX_UI_HARDWARE_FAST_MODE=y
CONFIG_NUWAX_UI_ANIMATION_TARGET_FPS=40
CONFIG_NUWAX_UI_BACKGROUND_DECODE_ENABLE=y
CONFIG_NUWAX_UI_ASYNC_FLUSH_ENABLE=y
CONFIG_NUWAX_UI_DOUBLE_BUFFER_ENABLE=y
CONFIG_NUWAX_UI_DRAW_BUFFER_LINES=20
CONFIG_NUWAX_UI_FLUSH_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_LV_DEF_REFR_PERIOD=5

# The current V28 drawer/focus menu code directly references these LVGL features.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=n
CONFIG_LV_USE_MICROPYTHON_MALLOC=n
CONFIG_LV_USE_RTTHREAD_MALLOC=n
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_28_COMPRESSED=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="nuwax_lvgl_assert.h"
# Product UI does not use LVGL sample applications; keep their code out of
# release images and avoid pulling unused demo symbols into the link.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
# CONFIG_BT_NIMBLE_GATT_CLIENT is not set
CONFIG_BT_NIMBLE_GATT_SERVER=y
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=4
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set
# CONFIG_BT_NIMBLE_SM_SIGN_CNT is not set
# CONFIG_BT_NIMBLE_CPFD_CAFD is not set
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
CONFIG_NETWORK_PROV_BLE_NOTIFY=y
CONFIG_NETWORK_PROV_SCAN_MAX_ENTRIES=32
CONFIG_NETWORK_PROV_WIFI_STA_FAST_SCAN=y
CONFIG_NUWAX_PROVISION_SUCCESS_BLE_HOLD_MS=15000
CONFIG_NUWAX_PROVISION_SECURITY_SESSION_TIMEOUT_MS=15000
CONFIG_NUWAX_PROVISION_APP_PRECONFIG_IDLE_TIMEOUT_MS=300000
CONFIG_NUWAX_PROVISION_APP_SESSION_IDLE_TIMEOUT_MS=60000
CONFIG_NUWAX_PROVISION_FAILURE_STATUS_HOLD_MS=5000
CONFIG_NUWAX_PROVISION_RUNTIME_IDLE_TIMEOUT_MS=600000
CONFIG_NUWAX_PROVISION_RUNTIME_REBOOT_ENABLE=y
CONFIG_NUWAX_PROVISION_OLD_WIFI_ATTEMPT_MS=20000
CONFIG_NUWAX_PROVISION_OLD_WIFI_RETRY_MS=15000
CONFIG_NUWAX_PROVISION_VOX_CONFIG_JOB_TIMEOUT_MS=15000
CONFIG_NUWAX_PROVISION_USB_CONTROL_ENABLE=y

# Miaopan V2.0 board baseline. Diagnostic modes remain opt-in so the default
# firmware continues into Wi-Fi, cloud, provisioning and all audio modes.
CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0=y
# CONFIG_NUWAX_P1_HW_DIAG_MODE is not set
# CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE is not set
# CONFIG_NUWAX_HW_ACCEPTANCE_MODE is not set
CONFIG_NUWAX_P2_AUDIO_SMOKE_DURATION_MS=5000
# CONFIG_NUWAX_VOCAT_SLOT2_AEC_REF_ENABLE is not set
# CONFIG_NUWAX_VOCAT_MIC3_REFERENCE_PRODUCTION_PROVEN is not set
# CONFIG_NUWAX_P3_HARDREF_AEC_AB_ENABLE is not set
# CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE is not set
# CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_UI_RUNTIME is not set
# CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME is not set
CONFIG_NUWAX_MIC_I2S_BCLK_GPIO=40
CONFIG_NUWAX_MIC_I2S_WS_GPIO=39
CONFIG_NUWAX_MIC_I2S_DIN_GPIO=38
CONFIG_NUWAX_SPEAKER_I2S_PORT=0
CONFIG_NUWAX_SPEAKER_I2S_BCLK_GPIO=40
CONFIG_NUWAX_SPEAKER_I2S_WS_GPIO=39
CONFIG_NUWAX_SPEAKER_I2S_DOUT_GPIO=41
CONFIG_NUWAX_SPEAKER_SD_GPIO=4
CONFIG_NUWAX_POWER_CTRL_GPIO=7
CONFIG_NUWAX_POWER_CTRL_HOLD_HIGH=y
CONFIG_BOOTLOADER_NUWAX_EARLY_POWER_HOLD=y
CONFIG_BOOTLOADER_NUWAX_POWER_HOLD_GPIO=7
CONFIG_NUWAX_POWER_KEY_ENABLE=y
CONFIG_NUWAX_POWER_KEY_GPIO=16
CONFIG_NUWAX_POWER_KEY_ACTIVE_LOW=y
CONFIG_NUWAX_POWER_KEY_POLL_MS=20
CONFIG_NUWAX_POWER_KEY_DEBOUNCE_MS=60
CONFIG_NUWAX_POWER_KEY_LONG_PRESS_MS=3000
CONFIG_NUWAX_POWER_KEY_FORCE_OFF_HOLD_MS=5000
CONFIG_NUWAX_DISPLAY_PIN_SCK=14
CONFIG_NUWAX_DISPLAY_PIN_MOSI=13
CONFIG_NUWAX_DISPLAY_PIN_DATA1=9
CONFIG_NUWAX_DISPLAY_PIN_DATA2=12
CONFIG_NUWAX_DISPLAY_PIN_DATA3=46
CONFIG_NUWAX_DISPLAY_PIN_CS=10
CONFIG_NUWAX_DISPLAY_PIN_RST=21
CONFIG_NUWAX_DISPLAY_PIN_BL=3
CONFIG_NUWAX_DISPLAY_RST_ACTIVE_HIGH=n
CONFIG_NUWAX_DISPLAY_BL_ACTIVE_LOW=n
CONFIG_NUWAX_TOUCH_PIN_INT=11
CONFIG_NUWAX_TOUCH_PIN_RST=-1
CONFIG_NUWAX_TOUCH_PIN_SCL=1
CONFIG_NUWAX_TOUCH_PIN_SDA=2

# Development-only URL music playback must remain disabled in product builds.
# Enable it only through the dedicated sdkconfig.music-url-test.defaults
# overlay when running the isolated LAN test firmware.
# CONFIG_NUWAX_MUSIC_URL_TEST_ENABLE is not set

# Production offline meeting/monitoring archives use the authenticated cloud
# WebSocket. The LAN replay test is deliberately disabled in the product
# baseline.
CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE=y
CONFIG_NUWAX_SD_SESSION_ENABLE=y
CONFIG_NUWAX_SD_LEGACY_CONTROL_COMPAT=y
CONFIG_NUWAX_OFFLINE_AUDIO_MAX_SEGMENT_BYTES=4194304
# CONFIG_NUWAX_SD_GATEWAY_DISCOVERY_ENABLE is not set
CONFIG_NUWAX_MONITORING_OFFLINE_MAX_HOURS=8
# CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE is not set
CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_FORMAL_ENABLE=y

# PCM archive budget: eight hours plus backlog headroom.
CONFIG_NUWAX_OFFLINE_AUDIO_MAX_BYTES=1610612736

# Cache style groups: 8 bytes per object; avoids repeated absent-style searches.
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_CJSON_NESTING_LIMIT=32
